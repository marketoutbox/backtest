UPSTOX_ACCESS_TOKEN=your-upstox-token
WORKER_SECRET=same-long-random-secret-as-vercel
DATABASE_URL=postgresql://user:password@host:5432/database
S3_ENDPOINT_URL=https://your-object-store-endpoint
S3_BUCKET=upstox-candles
S3_ACCESS_KEY_ID=your-key
S3_SECRET_ACCESS_KEY=your-secret
S3_REGION=auto
MAX_REQUESTS_PER_MINUTE=450
IMPORT_WORKERS=8
CACHE_DIR=/data/parquet-cache
