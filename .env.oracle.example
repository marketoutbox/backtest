# Copy to .env.oracle on the VM. Never commit .env.oracle.
# Use a DNS name pointing to the VM public IP, e.g. an existing domain you own.
SITE_HOST=worker.example.com
# Generate each secret on the VM: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-hex-secret
WORKER_SECRET=replace-with-different-hex-secret
# Upstox server-side token. Rotate it according to Upstox token expiry.
UPSTOX_ACCESS_TOKEN=replace-with-current-token
