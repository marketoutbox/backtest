# Set only AFTER enabling Vercel Authentication for All Deployments.
SITE_ACCESS_MODE=vercel
# Backend connection is configured when the persistent worker is ready.
WORKER_URL=https://your-worker.example.com
WORKER_SECRET=replace-with-long-random-secret
# Optional alternative to Vercel Authentication:
# SITE_USERNAME=owner
# SITE_PASSWORD=your-private-password
